generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RECEPTION
  TEACHER
}

enum AccountDateFormat {
  DD_MM_YY
  MM_DD_YY
  YYYY_MM_DD
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum LessonStatus {
  DRAFT
  SUBMITTED
}

enum SubstitutionStatus {
  NONE
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum HomeworkStatus {
  COMPLETED
  INCOMPLETE
}

enum LetterGrade {
  D_MINUS
  D
  D_PLUS
  C_MINUS
  C
  C_PLUS
  B_MINUS
  B
  B_PLUS
  A_MINUS
  A
}

enum PartialEvaluationPeriod {
  CLASS_7
  CLASS_23
}

enum TestPeriod {
  MID_TERM
  FINAL
}

enum TeacherWorkCategory {
  BONUS_CLASS
  EXTRA_ACTIVITY
  MEETING
  OTHER
}

enum BonusClassStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum BonusClassAttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  EXCUSED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TEACHER)
  dateFormat   AccountDateFormat @default(DD_MM_YY)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classes             Class[]              @relation("TeacherClasses")
  createdBonusClasses BonusClass[]         @relation("CreatedBonusClasses")
  confirmedBonusClasses BonusClass[]       @relation("ConfirmedBonusClassAttendance")
  createdWorkLogs     TeacherWorkLog[]     @relation("CreatedTeacherWorkLogs")
  passwordResetTokens PasswordResetToken[]
  submittedLessons    Lesson[]             @relation("SubmittedBy")
  resolvedRiskRecords StudentRiskResolution[] @relation("ResolvedRiskRecords")
  reviewedSubstitutions Lesson[]           @relation("ReviewedSubstitutions")
  taughtLessons       Lesson[]             @relation("TaughtBy")
  taughtBonusClasses  BonusClass[]         @relation("TaughtBonusClasses")
  teacherWorkLogs     TeacherWorkLog[]     @relation("TeacherWorkLogs")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Class {
  id              String    @id @default(cuid())
  name            String
  book            String?
  semester        Int?
  year            Int?
  durationMinutes Int       @default(60)
  weekDays        Weekday[] @default([])
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teacherId               String
  teacher                 User                     @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments             Enrollment[]
  lessons                 Lesson[]
  partialEvaluationGrades PartialEvaluationGrade[]
  riskResolutions         StudentRiskResolution[]
  testGrades              TestGrade[]

  @@index([teacherId])
}

model Student {
  id        String   @id @default(cuid())
  fullName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments             Enrollment[]
  attendanceRecords       AttendanceRecord[]
  bonusClasses            BonusClass[]
  homeworkRecords         HomeworkRecord[]
  partialEvaluationGrades PartialEvaluationGrade[]
  riskResolutions         StudentRiskResolution[]
  testGrades              TestGrade[]
  teacherWorkLogs         TeacherWorkLogStudent[]
}

model StudentRiskResolution {
  id                  String   @id @default(cuid())
  resolvedThroughDate DateTime
  resolvedAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  classId      String
  class        Class   @relation(fields: [classId], references: [id])
  studentId    String
  student      Student @relation(fields: [studentId], references: [id])
  resolvedById String
  resolvedBy   User    @relation("ResolvedRiskRecords", fields: [resolvedById], references: [id])

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([resolvedById])
}

model Enrollment {
  id        String           @id @default(cuid())
  status    EnrollmentStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@index([studentId])
}

model Lesson {
  id                     String             @id @default(cuid())
  name                   String?
  lessonDate             DateTime
  status                 LessonStatus       @default(DRAFT)
  substitutionStatus     SubstitutionStatus @default(NONE)
  substitutionNotes      String?
  substitutionReviewedAt DateTime?
  notes                  String?
  submittedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  classId           String
  class             Class              @relation(fields: [classId], references: [id])
  submittedById     String?
  submittedBy       User?              @relation("SubmittedBy", fields: [submittedById], references: [id])
  taughtById        String?
  taughtBy          User?              @relation("TaughtBy", fields: [taughtById], references: [id])
  substitutionReviewedById String?
  substitutionReviewedBy   User?       @relation("ReviewedSubstitutions", fields: [substitutionReviewedById], references: [id])
  attendanceRecords AttendanceRecord[]
  homeworkRecords   HomeworkRecord[]

  @@unique([classId, lessonDate, name])
  @@index([submittedById])
  @@index([taughtById])
  @@index([substitutionStatus])
  @@index([substitutionReviewedById])
}

model TeacherWorkLog {
  id              String              @id @default(cuid())
  category        TeacherWorkCategory
  subject         String?
  title           String
  workDate        DateTime
  startTime       String?
  durationMinutes Int
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  teacherId   String
  teacher     User   @relation("TeacherWorkLogs", fields: [teacherId], references: [id])
  createdById String
  createdBy   User   @relation("CreatedTeacherWorkLogs", fields: [createdById], references: [id])
  students    TeacherWorkLogStudent[]

  @@index([teacherId, workDate])
  @@index([createdById])
}

model TeacherWorkLogStudent {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())

  teacherWorkLogId String
  teacherWorkLog   TeacherWorkLog @relation(fields: [teacherWorkLogId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id])

  @@unique([teacherWorkLogId, studentId])
  @@index([studentId])
}

model BonusClass {
  id              String           @id @default(cuid())
  subject         String
  scheduledDate   DateTime
  startTime       String
  durationMinutes Int
  status          BonusClassStatus @default(SCHEDULED)
  attendanceStatus BonusClassAttendanceStatus @default(PENDING)
  notes           String?
  completedAt     DateTime?
  attendanceConfirmedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  studentId   String
  student     Student @relation(fields: [studentId], references: [id])
  teacherId   String
  teacher     User    @relation("TaughtBonusClasses", fields: [teacherId], references: [id])
  createdById String
  createdBy   User    @relation("CreatedBonusClasses", fields: [createdById], references: [id])
  attendanceConfirmedById String?
  attendanceConfirmedBy   User?   @relation("ConfirmedBonusClassAttendance", fields: [attendanceConfirmedById], references: [id])

  @@index([attendanceConfirmedById])
  @@index([attendanceStatus])
  @@index([createdById])
  @@index([studentId])
  @@index([teacherId, scheduledDate])
  @@index([status])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lessonId  String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model HomeworkRecord {
  id        String         @id @default(cuid())
  status    HomeworkStatus @default(INCOMPLETE)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  lessonId  String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model PartialEvaluationGrade {
  id        String                  @id @default(cuid())
  period    PartialEvaluationPeriod
  grade     LetterGrade
  notes     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId, period])
  @@index([studentId])
}

model TestGrade {
  id               String      @id @default(cuid())
  period           TestPeriod
  oralGrade        LetterGrade
  compositionScore Decimal     @db.Decimal(4, 2)
  writtenTestScore Decimal     @db.Decimal(4, 2)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId, period])
  @@index([studentId])
}

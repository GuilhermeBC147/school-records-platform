generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum LessonStatus {
  DRAFT
  SUBMITTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum HomeworkStatus {
  COMPLETED
  INCOMPLETE
  NOT_ASSIGNED
}

enum LetterGrade {
  D_MINUS
  D
  D_PLUS
  C_MINUS
  C
  C_PLUS
  B_MINUS
  B
  B_PLUS
  A_MINUS
  A
}

enum PartialEvaluationPeriod {
  CLASS_7
  CLASS_23
}

enum TestPeriod {
  MID_TERM
  FINAL
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TEACHER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classes             Class[]              @relation("TeacherClasses")
  passwordResetTokens PasswordResetToken[]
  submittedLessons    Lesson[]             @relation("SubmittedBy")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Class {
  id              String    @id @default(cuid())
  name            String
  book            String?
  semester        Int?
  year            Int?
  durationMinutes Int       @default(60)
  weekDays        Weekday[] @default([])
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teacherId               String
  teacher                 User                     @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments             Enrollment[]
  lessons                 Lesson[]
  partialEvaluationGrades PartialEvaluationGrade[]
  testGrades              TestGrade[]

  @@index([teacherId])
}

model Student {
  id        String   @id @default(cuid())
  fullName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments             Enrollment[]
  attendanceRecords       AttendanceRecord[]
  homeworkRecords         HomeworkRecord[]
  partialEvaluationGrades PartialEvaluationGrade[]
  testGrades              TestGrade[]
}

model Enrollment {
  id        String           @id @default(cuid())
  status    EnrollmentStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@index([studentId])
}

model Lesson {
  id          String       @id @default(cuid())
  name        String?
  lessonDate  DateTime
  status      LessonStatus @default(DRAFT)
  notes       String?
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  classId           String
  class             Class              @relation(fields: [classId], references: [id])
  submittedById     String?
  submittedBy       User?              @relation("SubmittedBy", fields: [submittedById], references: [id])
  attendanceRecords AttendanceRecord[]
  homeworkRecords   HomeworkRecord[]

  @@unique([classId, lessonDate])
  @@index([submittedById])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lessonId  String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model HomeworkRecord {
  id        String         @id @default(cuid())
  status    HomeworkStatus @default(NOT_ASSIGNED)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  lessonId  String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model PartialEvaluationGrade {
  id        String                  @id @default(cuid())
  period    PartialEvaluationPeriod
  grade     LetterGrade
  notes     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId, period])
  @@index([studentId])
}

model TestGrade {
  id               String      @id @default(cuid())
  period           TestPeriod
  oralGrade        LetterGrade
  compositionScore Decimal     @db.Decimal(4, 2)
  writtenTestScore Decimal     @db.Decimal(4, 2)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId, period])
  @@index([studentId])
}

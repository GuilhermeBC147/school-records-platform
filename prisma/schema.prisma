generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum LessonStatus {
  DRAFT
  SUBMITTED
  SYNCED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum HomeworkStatus {
  COMPLETED
  INCOMPLETE
  NOT_ASSIGNED
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum SyncAction {
  CREATE_ATTENDANCE
  UPDATE_ATTENDANCE
  CREATE_HOMEWORK
  UPDATE_HOMEWORK
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            UserRole @default(TEACHER)
  sponteTeacherId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classes          Class[]  @relation("TeacherClasses")
  submittedLessons Lesson[] @relation("SubmittedBy")
}

model Class {
  id            String   @id @default(cuid())
  name          String
  level         String?
  sponteClassId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacherId   String
  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  lessons     Lesson[]

  @@index([teacherId])
}

model Student {
  id              String   @id @default(cuid())
  fullName        String
  preferredName   String?
  sponteStudentId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  homeworkRecords   HomeworkRecord[]
}

model Enrollment {
  id        String           @id @default(cuid())
  status    EnrollmentStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@index([studentId])
}

model Lesson {
  id             String       @id @default(cuid())
  lessonDate     DateTime
  status         LessonStatus @default(DRAFT)
  notes          String?
  submittedAt    DateTime?
  sponteLessonId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  classId           String
  class             Class              @relation(fields: [classId], references: [id])
  submittedById     String?
  submittedBy       User?              @relation("SubmittedBy", fields: [submittedById], references: [id])
  attendanceRecords AttendanceRecord[]
  homeworkRecords   HomeworkRecord[]
  syncJobs          SyncJob[]

  @@unique([classId, lessonDate])
  @@index([submittedById])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lessonId  String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model HomeworkRecord {
  id        String         @id @default(cuid())
  status    HomeworkStatus @default(NOT_ASSIGNED)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  lessonId  String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model SyncJob {
  id             String     @id @default(cuid())
  action         SyncAction
  status         SyncStatus @default(PENDING)
  requestPayload Json?
  responseBody   Json?
  errorMessage   String?
  attemptedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  @@index([lessonId])
  @@index([status])
}

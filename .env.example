# Copy this file to .env.local for local development.

# Required later when the database is added.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/integracao_sponte"

# Required later when authentication is added.
AUTH_SECRET="replace-with-a-long-random-string"

# Required later when Sponte credentials are available.
SPONTE_API_BASE_URL="https://webservices.sponteweb.com.br/WSApiSponteRest"
SPONTE_API_KEY=""

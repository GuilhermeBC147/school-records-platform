# Copy this file to .env.local for local development.

# Local development database. Matches docker-compose.yml.
DATABASE_URL="postgresql://sponte_app:sponte_dev_password@localhost:5432/integracao_sponte?schema=public"

# Required later when authentication is added.
AUTH_SECRET="replace-with-a-long-random-string"

# Required later when Sponte credentials are available.
SPONTE_API_BASE_URL="https://webservices.sponteweb.com.br/WSApiSponteRest"
SPONTE_API_KEY=""

[Unit]
Description=School Records nightly PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=school-records-deploy
Group=school-records-deploy
Environment=ENV_FILE=/etc/school-records-platform/production.env
WorkingDirectory=/opt/school-records-platform/current
ExecStart=/opt/school-records-platform/current/ops/backup-postgres.sh scheduled
PrivateTmp=true
NoNewPrivileges=true

[Unit]
Description=Check School Records containers and host resources
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=school-records-deploy
Group=school-records-deploy
Environment=ENV_FILE=/etc/school-records-platform/production.env
WorkingDirectory=/opt/school-records-platform/current
ExecStart=/opt/school-records-platform/current/ops/monitor.sh
PrivateTmp=true
NoNewPrivileges=true

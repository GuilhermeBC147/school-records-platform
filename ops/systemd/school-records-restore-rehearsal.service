[Unit]
Description=Rehearse a School Records PostgreSQL restore
Requires=docker.service
After=docker.service school-records-backup.service

[Service]
Type=oneshot
User=school-records-deploy
Group=school-records-deploy
Environment=ENV_FILE=/etc/school-records-platform/production.env
WorkingDirectory=/opt/school-records-platform/current
ExecStart=/opt/school-records-platform/current/ops/restore-rehearsal.sh
PrivateTmp=true
NoNewPrivileges=true

    "next": "latest",
    "pg": "^8.22.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "^7.8.0",
    "typescript": "latest"
  }
}

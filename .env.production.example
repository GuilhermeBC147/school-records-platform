# Copy to /etc/school-records-platform/production.env on the VPS.
# Keep the real file owned by root:school-records-deploy with mode 0640.

# Public hostname only; DNS must point to the VPS before Caddy can issue TLS.
APP_DOMAIN=records.example.edu.br
APP_URL=https://records.example.edu.br
CADDY_ACME_EMAIL=operations@example.edu.br

# Immutable images produced by the deployment workflow. The deploy script overrides
# these values for each release, but Compose config validation requires placeholders.
APP_IMAGE=ghcr.io/example/school-records-platform:replace-with-git-sha
MIGRATION_IMAGE=ghcr.io/example/school-records-platform:replace-with-git-sha-migration

# PostgreSQL owner is used only for initialization, migrations, backup, and restore.
POSTGRES_DB=school_records
POSTGRES_USER=school_records_owner
POSTGRES_PASSWORD=replace-with-a-random-owner-password

# The application uses a separate runtime role with no schema-creation responsibility.
APP_DATABASE_USER=school_records_app
APP_DATABASE_PASSWORD=replace-with-a-random-app-password
DATABASE_URL=postgresql://school_records_app:replace-with-url-encoded-app-password@postgres:5432/school_records?schema=public
MIGRATION_DATABASE_URL=postgresql://school_records_owner:replace-with-url-encoded-owner-password@postgres:5432/school_records?schema=public

# Generate independently from all database and local-development secrets.
AUTH_SECRET=replace-with-a-long-random-auth-secret

# School-owned Hostinger mailbox for password-reset messages. Port 465 requires
# SMTP_SECURE=true; alternatively use port 587 with SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-full-hostinger-mailbox@example.edu.br
SMTP_PASSWORD='replace-with-hostinger-mailbox-password'
SMTP_FROM="School Records <replace-with-full-hostinger-mailbox@example.edu.br>"

TZ=America/Sao_Paulo

# Host paths and policy used by repository backup/monitoring scripts.
BACKUP_DIR=/var/backups/school-records-platform/postgres
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=30
REQUIRE_OFFSITE_BACKUP=true
RCLONE_REMOTE=school-owned-remote:school-records-platform/postgres

# Generic HTTPS endpoint owned by the school. Leave blank only during provisioning.
ALERT_WEBHOOK_URL=
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
MEMORY_WARNING_PERCENT=85
CPU_WARNING_PERCENT=85
